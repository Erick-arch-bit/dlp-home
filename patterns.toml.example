# ──────────────────────────────────────────────
# DLP Home — Detection Patterns (TOML)
# ──────────────────────────────────────────────
#
# Copy to /etc/dlp/patterns.toml:
#   sudo cp patterns.toml.example /etc/dlp/patterns.toml

[[pattern]]
name = "credit_card"
description = "Credit card number"
severity = "high"
regex = '\b(?:\d[ -]*?){13,19}\b'

[[pattern]]
name = "ssn"
description = "US Social Security Number"
severity = "critical"
regex = '\b\d{3}-\d{2}-\d{4}\b'

[[pattern]]
name = "curp"
description = "CURP (Mexico)"
severity = "high"
regex = '\b[A-Z]{4}\d{6}[H,M][A-Z]{5}[0-9A-Z]\d\b'

[[pattern]]
name = "rfc"
description = "RFC (Mexico)"
severity = "high"
regex = '\b[A-ZÑ&]{3,4}\d{6}[A-Z0-9]{2,3}\b'

[[pattern]]
name = "email"
description = "Email address"
severity = "low"
regex = '\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b'

[[pattern]]
name = "api_key"
description = "API key or token"
severity = "high"
regex = '(?i)(?:api[_-]?key|apikey|secret|token|bearer)\s*[:=]\s*[''"]?[A-Za-z0-9_\-=]{16,64}[''"]?'

[[pattern]]
name = "private_key"
description = "Private key (RSA/DSA/EC)"
severity = "critical"
regex = '-----BEGIN (?:RSA |DSA |EC )?PRIVATE KEY-----'

[[pattern]]
name = "password"
description = "Plain text password"
severity = "high"
regex = '(?i)(?:password|passwd|pwd|contraseña)\s*[:=]\s*\S{6,}'

[[pattern]]
name = "connection_string"
description = "Database connection string"
severity = "critical"
regex = '(?i)(?:postgres(?:ql)?|mysql|mongodb|redis|sqlite)://\S+:\S+@'

[[pattern]]
name = "aws_key"
description = "AWS Access Key"
severity = "critical"
regex = '(?i)AKIA[0-9A-Z]{16}'

[[pattern]]
name = "github_token"
description = "GitHub token"
severity = "critical"
regex = '(?i)gh[ps]_[A-Za-z0-9]{36,}'

[[pattern]]
name = "phone_mx"
description = "Mexican phone number"
severity = "medium"
regex = '\b(?:52)?(?:\d{2}[-\s]?)?\d{4}[-\s]?\d{4}\b'

[[pattern]]
name = "jwt_token"
description = "JWT token"
severity = "high"
regex = 'eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}'

[[pattern]]
name = "ip_address"
description = "Internal IP address"
severity = "low"
regex = '\b(?:10\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(?:1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3}|192\.168\.\d{1,3}\.\d{1,3})\b'
